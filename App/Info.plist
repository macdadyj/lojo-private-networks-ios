<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LOJO Networks</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppleMusicUsageDescription</key>
	<string>LOJO Networks plays songs from your Apple Music library when this iPhone is an iPhone Remote Controller sound machine.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LOJO Networks talks to your site gateway on the local network to show your devices, camera stills and controls. Nothing is sent to the public internet.</string>
	<!--
	No NSAppTransportSecurity exceptions: URLSession only speaks HTTPS (pinned to the site CA,
	see docs/tls.md). The labelled legacy-HTTP fallback runs on Network.framework (PlainHTTP.swift),
	which ATS does not govern.
	-->
	<!--
	Offer the paired "Legacy HTTP over VPN" fallback. This is the dev value; scripts/deploy-phone.sh
	sets it false in the build copy for release builds (see README "Dev and release builds").
	-->
	<key>LOJOLegacyHTTPOverVPN</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shortcuts</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lojo.PrivateNetworks.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lojo</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
